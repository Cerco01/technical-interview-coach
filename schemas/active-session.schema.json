{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.interview-coach/schemas/active-session.schema.json",
  "title": "Deterministic session state",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "session_id", "flow", "mode", "status", "phase", "revision", "seed", "started_at", "deadline_at", "ended_at", "question_limit", "duration_minutes", "hints_allowed", "current_question_id", "selected_question_ids", "eligible_candidate_ids", "eligible_candidate_digest", "history", "learner_context", "difficulty_state", "attempts", "selection_decisions", "score_inputs", "transition_log", "practice", "completion_reason", "report"],
  "properties": {
    "schema_version": {"const": 1},
    "session_id": {"type": "string", "pattern": "^session-[a-z0-9-]+$"},
    "flow": {"enum": ["practice", "assessment"]},
    "mode": {"enum": ["interview", "study", "review"]},
    "status": {"enum": ["active", "completed"]},
    "phase": {"enum": ["answering", "paused", "completed"]},
    "revision": {"type": "integer", "minimum": 0},
    "seed": {"type": "string"},
    "started_at": {"type": "string", "format": "date-time"},
    "deadline_at": {"type": ["string", "null"], "format": "date-time"},
    "ended_at": {"type": ["string", "null"], "format": "date-time"},
    "question_limit": {"type": "integer", "minimum": 0},
    "duration_minutes": {"type": "integer", "minimum": 0},
    "hints_allowed": {"type": "boolean"},
    "current_question_id": {"type": ["string", "null"]},
    "selected_question_ids": {"type": "array", "items": {"type": "string"}},
    "eligible_candidate_ids": {"type": "array", "items": {"type": "string"}},
    "eligible_candidate_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "history": {"type": "object"},
    "learner_context": {"type": ["object", "null"]},
    "difficulty_state": {"type": "object"},
    "attempts": {"type": "array", "items": {"type": "object"}},
    "selection_decisions": {"type": "array", "items": {"type": "object"}},
    "score_inputs": {"type": "array", "items": {"type": "object"}},
    "transition_log": {"type": "array", "items": {"type": "object"}},
    "practice": {"type": "object"},
    "completion_reason": {"type": ["string", "null"]},
    "report": {"type": ["object", "null"]}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.interview-coach/schemas/question.schema.json",
  "title": "Interview question",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","id","title","difficulty","topic_ids","priority_rank","tier","primary_format","primary_category","prompt","evaluation","expected_concepts","rubric","hints","follow_ups"],
  "properties": {
    "schema_version": {"const": 3},
    "id": {"type":"string","pattern":"^q-[a-z0-9]+-[0-9]{3}$"},
    "title": {"type":"string","minLength":3},
    "difficulty": {"enum":["beginner","intermediate","advanced"]},
    "topic_ids": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z0-9-]+$"}},
    "priority_rank": {"type":"integer","minimum":1,"maximum":50},
    "tier": {"enum":["core","differentiator","specialized"]},
    "primary_format": {"enum":["implementation","sql_query","debugging","conceptual_reasoning","case_study","data_manipulation"]},
    "primary_category": {"enum":["python_algorithms","numpy","pandas_data_handling","sql","probability_statistics","mathematical_foundations","core_ml_evaluation","specialized_ml","api_project_reasoning"]},
    "prompt": {"type":"string","minLength":20},
    "evaluation": {
      "type":"object",
      "additionalProperties":false,
      "required":["strategy","submission_contract","evaluator_ref","objective_criteria"],
      "properties": {
        "strategy":{"enum":["executable","sql","dataframe","numeric","rubric_only"]},
        "submission_contract":{
          "type":"object",
          "additionalProperties":false,
          "required":["kind","filename"],
          "properties":{
            "kind":{"enum":["python_module","sql_query","answer_text"]},
            "filename":{"type":"string","pattern":"^[a-z0-9_.-]+$"},
            "entrypoint":{"type":"string","pattern":"^[a-z_][a-z0-9_]*$"},
            "signature":{"type":"string","pattern":"^\\([^\\n]*\\)$"},
            "returns":{"type":"string","minLength":3},
            "columns":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z_][a-z0-9_]*$"}}
          }
        },
        "evaluator_ref":{"type":["string","null"]},
        "objective_criteria":{"type":"array","uniqueItems":true,"items":{"type":"integer","minimum":0}}
      }
    },
    "expected_concepts": {"type":"array","minItems":1,"items":{"type":"string","minLength":2}},
    "rubric": {"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["criterion","points"],"properties":{"criterion":{"type":"string","minLength":3},"points":{"type":"integer","minimum":1,"maximum":10}}}},
    "hints": {"type":"array","minItems":1,"items":{"type":"string","minLength":3}},
    "follow_ups": {"type":"array","minItems":1,"items":{"type":"string","minLength":5}}
  }
}
